# AI Gem Hunter - Velocity Mode Configuration
# Philosophy: Filter rugs, bet on velocity, exit fast

# ═══════════════════════════════════════════════════════════════
# CORE SETTINGS
# ═══════════════════════════════════════════════════════════════

# Enable the new Velocity Hunter (Munger/Musk approach)
USE_VELOCITY_HUNTER=true

# Trading enabled
AUTO_TRADE_ENABLED=true

# Paper trading mode (logs trades but doesn't execute)
# Set to true until you're confident in the system
PAPER_TRADE_ONLY=true

# ═══════════════════════════════════════════════════════════════
# VELOCITY THRESHOLDS
# ═══════════════════════════════════════════════════════════════

# Minimum velocity score to send alert (0-100)
MIN_VELOCITY_ALERT=30

# Minimum velocity score to execute trade (0-100)
MIN_VELOCITY_TRADE=50

# ═══════════════════════════════════════════════════════════════
# POSITION LIMITS (Risk Management)
# ═══════════════════════════════════════════════════════════════

# Max concurrent positions
MAX_POSITIONS=5

# Max trades per day
MAX_DAILY_TRADES=20

# Reserve SOL (never trade below this)
RESERVE_SOL=0.15

