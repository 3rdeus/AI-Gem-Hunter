# ═══════════════════════════════════════════════════════════════
# AI GEM HUNTER - Environment Configuration
# ═══════════════════════════════════════════════════════════════
# Copy this to .env and fill in your values

# ───────────────────────────────────────────────────────────────
# REQUIRED - Core services
# ───────────────────────────────────────────────────────────────

# Helius - Solana RPC & data (https://helius.dev)
HELIUS_API_KEY=your_helius_api_key
HELIUS_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_API_KEY

# Supabase - Database (https://supabase.com)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Telegram - Alerts (https://t.me/BotFather)
TELEGRAM_BOT_TOKEN=your_bot_token
TELEGRAM_CHAT_ID=your_chat_id

# ───────────────────────────────────────────────────────────────
# OPTIONAL - Enhanced features
# ───────────────────────────────────────────────────────────────

# Birdeye - Token data (https://birdeye.so)
BIRDEYE_API_KEY=

# GoPlus - Security analysis (https://gopluslabs.io)
GOPLUS_API_KEY=

# Solscan - Token metadata
SOLSCAN_API_KEY=

# ───────────────────────────────────────────────────────────────
# TRADING - Auto-trade settings (DISABLED by default)
# ───────────────────────────────────────────────────────────────

AUTO_TRADE_ENABLED=false
TRADE_AMOUNT_SOL=0.1
TRADE_SLIPPAGE=25

# ───────────────────────────────────────────────────────────────
# ADVANCED - Usually don't need to change
# ───────────────────────────────────────────────────────────────

NODE_ENV=production
LOG_LEVEL=info
