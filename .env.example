# ═══════════════════════════════════════════════════════════════
# AI GEM HUNTER - Environment Configuration
# Copy to .env and fill in your API keys
# ═══════════════════════════════════════════════════════════════

# ───────────────────────────────────────────────────────────────
# REQUIRED - Core Functionality
# ───────────────────────────────────────────────────────────────

# Birdeye - Token data, prices, WebSocket streams
# Get key: https://birdeye.so/api
BIRDEYE_API_KEY=

# Helius - Solana RPC, transaction data, webhooks
# Get key: https://helius.dev/
HELIUS_API_KEY=
HELIUS_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
HELIUS_WEBSOCKET_URL=wss://mainnet.helius-rpc.com/?api-key=YOUR_KEY

# Supabase - Database for tracking positions, wallets, performance
# Get key: https://supabase.com/dashboard
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic Claude - AI scam pattern analysis
# Get key: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Telegram - Alerts delivery
# Create bot: https://t.me/BotFather
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=7697687181

# ───────────────────────────────────────────────────────────────
# REQUIRED - Security Checks
# ───────────────────────────────────────────────────────────────

# GoPlus - Contract security, honeypot detection
# Get key: https://gopluslabs.io/
GOPLUS_APP_KEY=
GOPLUS_APP_SECRET=

# Solscan - Token metadata, holder data
# Get key: https://solscan.io/
SOLSCAN_API_KEY=

# ───────────────────────────────────────────────────────────────
# OPTIONAL - Enhanced Features
# ───────────────────────────────────────────────────────────────

# Nansen - Smart money tracking (premium)
# Get key: https://nansen.ai/
NANSEN_API_KEY=

# OpenAI - Alternative AI analysis
# Get key: https://platform.openai.com/
OPENAI_API_KEY=

# ───────────────────────────────────────────────────────────────
# TRADING CONFIGURATION
# ───────────────────────────────────────────────────────────────

# Enable auto-trading via Bonk Bot
AUTO_TRADE_ENABLED=false

# Trade amount in SOL per position
TRADE_AMOUNT_SOL=0.1

# Slippage tolerance (%)
TRADE_SLIPPAGE=25

# Bonk Bot integration
# Get from Bonk Bot Telegram
BONK_BOT_CHAT_ID=

# ───────────────────────────────────────────────────────────────
# SERVER CONFIGURATION
# ───────────────────────────────────────────────────────────────

PORT=3000
NODE_ENV=development

# Direct Postgres connection (alternative to Supabase client)
# DATABASE_URL=postgresql://user:pass@host:5432/dbname
